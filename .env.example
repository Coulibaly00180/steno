DATABASE_URL=postgresql+psycopg://videoai:videoai@postgres:5432/videoai
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
MAX_VIDEO_HOURS=6
FFPROBE_TIMEOUT_SECONDS=60
FFMPEG_TIMEOUT_SECONDS=7200
RECOVER_INTERRUPTED_JOBS_ON_STARTUP=true

OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=900
# Context window sent to Ollama (tokens). Lower it (e.g. 6144) on machines short on RAM.
LLM_NUM_CTX=8192

# CPU safe defaults. For NVIDIA, compose.gpu.yaml overrides device + compute type.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

SUMMARY_CHUNK_CHARS=12000
TRANSLATION_CHUNK_CHARS=2500
CORS_ORIGINS=http://localhost:3000

# Live transcript of browser recordings (preview only; the full transcription runs at the end).
LIVE_WHISPER_MODEL=small
# Imports from a link: set to true to allow links to the local network (a NAS).
URL_IMPORT_ALLOW_PRIVATE=false

# Access from the local network (docker compose --profile reseau up -d): the address of this
# computer on the network, and the HTTPS port. Set by the Windows installer.
LAN_ADDRESS=steno.local
HTTPS_PORT=8443

# Videos processed in parallel. 1 by default: with a single graphics card, 2 brought no gain
# (docs/specs/performance-workers.md). Worth trying with a second card or many link downloads.
# WORKER_REPLICAS=2
