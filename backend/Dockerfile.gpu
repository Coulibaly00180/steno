FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# fonts-dejavu-core: every accent and symbol in the PDF reports (n°20).
# postgresql-client: pg_dump / pg_restore of the backups (n°13); Debian trixie
# ships version 17, the server's.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl fonts-dejavu-core postgresql-client && rm -rf /var/lib/apt/lists/*

# Speaker diarization models (n°8), fetched and checksum-verified at build time.
COPY scripts/fetch_diarization_models.py /tmp/
RUN python /tmp/fetch_diarization_models.py /opt/models/diarization

WORKDIR /app
COPY requirements.txt .
# Recent nvidia-* wheels are namespace packages (module __file__ is None):
# register every nvidia/*/lib directory with the dynamic linker instead.
RUN pip install -r requirements.txt \
    "nvidia-cublas-cu12>=12,<13" \
    "nvidia-cudnn-cu12>=9,<10" \
 && find /usr/local/lib/python3.12/site-packages/nvidia -maxdepth 2 -type d -name lib > /etc/ld.so.conf.d/nvidia-python.conf \
 && test -s /etc/ld.so.conf.d/nvidia-python.conf \
 && ldconfig
COPY . .

CMD ["python", "-m", "app.worker_entry"]
