FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# fonts-dejavu-core: every accent and symbol in the PDF reports (n°20).
# postgresql-client: the backup and restore tests (n°13).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl fonts-dejavu-core postgresql-client && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-test.txt ./
RUN pip install -r requirements-test.txt pyflakes
# Sources are bind-mounted by compose.test.yaml: no rebuild needed between runs.
CMD ["python", "-m", "pytest", "-q", "tests"]
