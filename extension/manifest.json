{
  "manifest_version": 3,
  "name": "Envoyer à Sténo",
  "version": "1.0.0",
  "description": "Envoie la vidéo ou le podcast de l'onglet ouvert à votre Sténo local, en un clic.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Envoyer à Sténo (clic droit : avec des options)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib.js", "background.js"]
  },
  "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Envoyer l'onglet à Sténo" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "browser_specific_settings": { "gecko": { "id": "envoyer@steno.local", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } } }
}
